<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Время вышло</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
        }

        body {
            background: linear-gradient(
                to right,
                #1a1a4e 0%,
                #1a1a4e 50%,
                #c62828 50%,
                #c62828 100%
            );
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .divider {
            position: absolute;
            width: 2px;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.2);
            left: 50%;
            transform: translateX(-50%);
            z-index: 1;
        }

        .stripe {
            width: 100%;
            max-width: 800px;
            height: 80px;
            background: #000;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            position: absolute;
            top: 50%;
            transform: translateY(-50%) scale(0.8);
            opacity: 0;
            animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes popIn {
            to {
                transform: translateY(-50%) scale(1);
                opacity: 1;
            }
        }

        .stripe span {
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 48px;
            font-weight: bold;
            letter-spacing: 4px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
            text-transform: uppercase;
        }

        /* Блок с кнопкой и счётчиком */
        .controls {
            position: absolute;
            bottom: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            z-index: 10;
        }

        .counter-display {
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 18px;
            font-weight: bold;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
        }

        button {
            padding: 12px 24px;
            font-size: 16px;
            background-color: #fff;
            color: #1a1a4e;
            border: none;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
            transition: transform 0.1s, box-shadow 0.2s;
        }

        button:hover {
            box-shadow: 0 0 12px rgba(255,255,255,0.4);
            transform: scale(1.05);
        }

        button:active {
            transform: scale(0.98);
        }

        @media (max-height: 400px) {
            .stripe { height: 60px; }
            .stripe span { font-size: 36px; letter-spacing: 3px; }
        }
    </style>
</head>
<body>
    <div class="divider"></div>
    <div class="stripe">
        <span>Время вышло</span>
    </div>

    <div class="controls">
        <div class="counter-display">Кликов: <span id="click-count">0</span></div>
        <button id="refresh-btn">Обновить страницу</button>
    </div>

    <script>
        const btn = document.getElementById('refresh-btn');
        const countSpan = document.getElementById('click-count');

        // Загружаем сохранённое значение из localStorage
        let clicks = localStorage.getItem('refreshClicks') || 0;
        countSpan.textContent = clicks;

        btn.addEventListener('click', () => {
            clicks++;
            localStorage.setItem('refreshClicks', clicks);
            countSpan.textContent = clicks;
            // Обновляем страницу
            location.reload();
        });
    </script>
</body>
</html>
